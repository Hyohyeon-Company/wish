# Local environment example for the wish composition.
#
# Copy to `.env` (git-ignored) or export the same names in your shell. Every
# value below is a local-development default; production supplies its own
# credentials from the environment and never relies on these.

# Host port the API is published on (the container port stays 3000).
WISH_API_PORT=3000

# Storage backend behind the repository ports:
#   mysql  — SQL adapters (docker-compose.yml pins this; data survives restarts)
#   memory — in-process adapters (an empty store after every restart)
WISH_STORAGE=mysql

# MySQL database created on first boot and used by the API.
WISH_DB_NAME=wish
WISH_DB_USER=wish
WISH_DB_PASSWORD=wish-local-password
WISH_DB_ROOT_PASSWORD=wish-local-root-password

# Only needed when the API runs outside compose (host process or another
# container). Inside compose the api service reaches the database as `mysql`.
# WISH_DB_HOST=127.0.0.1
# WISH_DB_PORT=3306
# WISH_DB_CONNECTION_LIMIT=10

# Migration/seed locations. The image sets these to /app/db/...; a host run
# finds db/ by walking up from the compiled module, so they stay optional.
# WISH_DB_MIGRATIONS_DIR=./db/migrations
# WISH_DB_SEED_DIR=./db/seed
